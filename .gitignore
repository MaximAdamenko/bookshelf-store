# ---- secrets (never commit) ----
.env
.env.*
!.env.example
# `.env` and `.env.*` do not match deploy/desec.env. This does, and leaves the
# committed desec.env.example alone.
*.env
!*.env.example
*.pem
*.key
docs/
.agents


# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- node / frontend ----
node_modules/
dist/
.vite/
*.local

# ---- uploads (user content, not source) ----
Server/uploads/*
!Server/uploads/.gitkeep

# ---- os / editor ----
.DS_Store
.idea/
.vscode/
*.swp


# ---- venv ----
Server/.venv/
