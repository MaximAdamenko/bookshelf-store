# Copy to /etc/bookshelf/desec.env (0640 root:bookshelf-ddns) and fill in.
# install.sh does that copy for you. The real file is never committed.

# Your dedyn.io domain. This doubles as the dyndns2 "username".
DESEC_DOMAIN=

# The token secret from deSEC. This is the dyndns2 "password", and it is the
# only genuinely secret value here. Scope it to A/AAAA on one domain -- see
# README.md. Your deSEC *account* password must never be put on the instance.
DESEC_TOKEN=

# Empty clears the AAAA record on every update -- what an IPv4-only instance
# wants, because a stale AAAA makes IPv6 clients hang before falling back.
# Set to "preserve" once the instance actually has IPv6.
DESEC_AAAA=
