# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------- database
# Full connection URL from the Postgres provider, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
#
# OWNER url: owns the schema, runs DDL. Used ONLY by db/init_db.py.
DATABASE_URL=
#
# APP url: DML only, no DDL. Used by the running API. See SECURITY.md 2.6.
# Leave blank to fall back to DATABASE_URL (the app will log a warning).
APP_DATABASE_URL=

# ------------------------------------------------------- first admin account
# Seeded by init_db.py. The password is argon2-hashed before it touches the DB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Max
ADMIN_LAST_NAME=Adamenko

# ---------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CHALLENGE_TOKEN_MINUTES=10

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MINUTES=30

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# -------------------------------------------------------------------- mail
# console = print the code to the terminal (dev). gmail = real SMTP.
MAIL_BACKEND=console
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ----------------------------------------------------------------- uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
MAX_IMAGE_PIXELS=40000000

# --------------------------------------------------------------------- app
ENV=dev
CORS_ORIGINS=http://localhost:5173
